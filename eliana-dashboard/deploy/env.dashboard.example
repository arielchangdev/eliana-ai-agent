# Eliana Dashboard runtime environment (copy to /etc/eliana/env.dashboard, chmod 600)
# Values below are placeholders — fill in your real paths/host before use.
# This example is safe to commit; the real file must NOT be committed.

# Serve mode and bind address
ELIANA_DASH__MODE=real
ELIANA_DASH__HOST=0.0.0.0
ELIANA_DASH__PORT=8080

# Dashboard's own sqlite db + built frontend
ELIANA_DASH__DB=/opt/eliana/data/dashboard.db
ELIANA_DASH__DIST=/opt/eliana/eliana-dashboard/frontend/dist

# Growth-status data sources (ChromaDB dirs + personality/bounty db)
ELIANA_DASH__KNOWLEDGE_DIR=YOUR_CHROMA_DIR
ELIANA_DASH__MEMORY_DIR=YOUR_MEMORY_DIR
ELIANA_DASH__PERSONALITY_DB=YOUR_PERSONALITY_DB
ELIANA_BOUNTY__DB=YOUR_BOUNTY_DB

# Weapon host (for the resource poller's remote metrics over SSH)
ELIANA_WEAPON__HOST=YOUR_WEAPON_HOST
ELIANA_WEAPON__USER=YOUR_WEAPON_USER
ELIANA_WEAPON__KEY=/etc/eliana/keys/your_weapon_key
