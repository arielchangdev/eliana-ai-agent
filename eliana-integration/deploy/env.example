# Eliana 敏感環境變數範本
#
# 用法：複製一份、填入真實值、source 它（不要 commit 真實值）
#   cp deploy/env.example deploy/env.local
#   nano deploy/env.local        # 填入真實值
#   source deploy/env.local
#
# 這些值會透過 ConfigManager 的 ELIANA_ 前綴機制覆寫 eliana.yaml。
# 雙底線 __ 代表 YAML 的層級分隔。

# --- Telegram（dashboard 通知）---
export ELIANA_TELEGRAM__BOT_TOKEN=""      # 從 @BotFather 取得
export ELIANA_TELEGRAM__CHAT_ID=""        # 你的 chat id

# --- Electrum 錢包 RPC ---
export ELIANA_WALLET__RPC_PASSWORD=""     # Electrum daemon RPC 密碼

# --- 選填：覆寫預設埠號/位址（若與 eliana.yaml 不同再填）---
# export ELIANA_OLLAMA__BASE_URL="http://127.0.0.1:11434"
# export ELIANA_CHROMADB__PORT="8001"
# export ELIANA_WALLET__ELECTRUM_RPC_URL="http://127.0.0.1:7777"

# --- 啟動模式（正式環境保持 false）---
# export ELIANA_APP__SKIP_VALIDATION="false"
# export ELIANA_APP__STANDALONE="false"
